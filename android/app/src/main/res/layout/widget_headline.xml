<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/morning_read_mark" android:contentDescription="@string/app_name" />
        <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:fontFamily="serif" android:text="@string/app_name" android:textColor="#163632" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="更新新聞" android:gravity="center" android:text="↻" android:textColor="#176B68" android:textSize="22sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="焦點新聞" android:textColor="#916421" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="3dp" />
    <ImageView android:id="@+id/widget_large_photo" android:layout_width="match_parent" android:layout_height="85dp" android:layout_marginTop="4dp" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="頭條圖片" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="serif" android:maxLines="2" android:text="正在載入今日頭條…" android:textColor="#163632" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:text="點擊閱讀" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_photo" android:layout_width="82dp" android:layout_height="72dp" android:layout_marginStart="8dp" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="新聞圖片" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_more1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:paddingVertical="3dp" />
        <TextView android:id="@+id/widget_more2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:paddingVertical="3dp" />
        <TextView android:id="@+id/widget_more3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:paddingVertical="3dp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_loading" android:textColor="#68746C" android:textSize="10sp" />
</LinearLayout>
